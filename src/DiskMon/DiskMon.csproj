<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DiskMon</RootNamespace>
    <AssemblyName>DiskMon</AssemblyName>
    <UserSecretsId>diskmon-c1f0a2b4</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by the source-generated GetDiskFreeSpaceEx interop in DriveInfoDiskProbe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The Windows service host and the Event Log sink are Windows-only. The app still runs as
         a terminal process on Linux/macOS, so the platform is asserted at the call site with
         OperatingSystem.IsWindows() rather than by narrowing the target framework. -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>

    <!-- A service is published as a folder and registered by absolute path, so the launcher
         settings and the generated appsettings.json only add noise. Settings live in
         settings/settings.xml. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.11" />

    <!-- Com.H family: SMTP mail, Graph mail, dated file logging. -->
    <PackageReference Include="Com.H" Version="10.3.0" />
    <PackageReference Include="Com.H.GraphAPI" Version="10.0.0" />
    <PackageReference Include="Com.H.Extensions.Logging.File" Version="1.3.0" />

    <!-- Required by the vendored Com.H.Text.Template2 sources under Com.H/Template2/.
         Remove it together with that folder once Com.H.Text.Template2 ships on NuGet. -->
    <PackageReference Include="Com.H.Data.Common" Version="10.1.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- PreserveNewest, never Always: an operator's edited settings.xml must survive a rebuild.
         A fresh output folder still gets the shipped defaults. -->
    <Content Include="settings\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiskMon.Tests" />
  </ItemGroup>

</Project>
